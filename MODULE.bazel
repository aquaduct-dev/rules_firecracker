module(
    name = "rules_firecracker",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# ---- dev dependencies (self-tests, examples, docs) -------------------------

# The guest-side k3s test binaries (examples/k3s_smoke, tests/k3s_extras).
bazel_dep(name = "rules_go", version = "0.60.0", dev_dependency = True)

# docs/: stardoc renders defs.bzl; write_source_files keeps docs/ in sync.
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.25.4")

# rules_oci builds the tiny OCI image the firecracker_container self-test
# boots (tests/container). Consumers bring their own image rules.
bazel_dep(name = "rules_oci", version = "2.3.0", dev_dependency = True)

# ---- pinned binaries --------------------------------------------------------

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Firecracker VMM, pinned to an official upstream release so the runners
# never depend on a `firecracker` on the host PATH. //:firecracker selects
# the binary matching the target CPU. Upgrades: bump the version in the
# urls/strip_prefix/build_file_content of both archives below and replace
# both sha256s with the values published in the release's
# firecracker-<ver>-<arch>.tgz.sha256.txt assets.
http_archive(
    name = "firecracker_x86_64",
    build_file_content = """
alias(name = "firecracker", actual = "firecracker-v1.17.0-x86_64", visibility = ["//visibility:public"])
exports_files(["firecracker-v1.17.0-x86_64"])
""",
    sha256 = "06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558",
    strip_prefix = "release-v1.17.0-x86_64",
    urls = ["https://github.com/firecracker-microvm/firecracker/releases/download/v1.17.0/firecracker-v1.17.0-x86_64.tgz"],
)

http_archive(
    name = "firecracker_aarch64",
    build_file_content = """
alias(name = "firecracker", actual = "firecracker-v1.17.0-aarch64", visibility = ["//visibility:public"])
exports_files(["firecracker-v1.17.0-aarch64"])
""",
    sha256 = "e351ebe4f7a16b5873bbd51005d2e6767103cff4d5ebc829df2d3f95a93e2256",
    strip_prefix = "release-v1.17.0-aarch64",
    urls = ["https://github.com/firecracker-microvm/firecracker/releases/download/v1.17.0/firecracker-v1.17.0-aarch64.tgz"],
)

# Statically-linked jq used by the firecracker_k3s_test launcher to validate
# the guest's report JSON (no host jq needed).
http_file(
    name = "jq_linux_amd64",
    downloaded_file_path = "jq",
    executable = True,
    sha256 = "020468de7539ce70ef1bceaf7cde2e8c4f2ca6c3afb84642aabc5c97d9fc2a0d",
    urls = ["https://github.com/jqlang/jq/releases/download/jq-1.8.1/jq-linux-amd64"],
)

# Firecracker boot kernel source. Linux 6.1.155 from kernel.org, built
# locally by //:vmlinux against //:vmlinux-6.1.config (the upstream
# firecracker microvm-kernel-ci-x86_64-6.1.config, which enables
# CONFIG_FUSE_FS=y). The prebuilt vmlinux on firecracker's CI bucket is
# missing FUSE, so we build from source. The pinned config also has
# CONFIG_RANDOM_TRUST_CPU=y so Go's crypto/rand doesn't block ~60s waiting
# for entropy. To upgrade: fetch new tarball, sha256sum it, bump version +
# sha below; refresh the .config from firecracker upstream if guest
# features change.
http_file(
    name = "firecracker_kernel_src",
    downloaded_file_path = "linux.tar.xz",
    sha256 = "c29387aeee085fbcbd91236224b9df805063bac43615e75cea2c6b29604a5c73",
    urls = ["https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.1.155.tar.xz"],
)

# Statically-linked busybox for the firecracker initramfs. Pinned by sha256
# so //:busybox_static is hermetic. Upstream serves the file without the
# executable bit; BUILD.bazel wraps it in a chmod-+x genrule before
# consumers see it.
http_file(
    name = "busybox_static_x86_64",
    downloaded_file_path = "busybox",
    sha256 = "6e123e7f3202a8c1e9b1f94d8941580a25135382b99e8d3e34fb858bba311348",
    urls = ["https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox"],
)

# Statically-linked k3s binary (single fat ELF that embeds containerd,
# kubelet, kube-apiserver, runc, flannel, coredns, etc.). Used by
# firecracker_k3s_test to bake a real k3s onto the microVM rootfs — k3s
# runs as PID 1 inside the guest, no nested container runtime involved.
# Upgrades: fetch the new release, sha256sum, bump tag + sha together.
http_file(
    name = "k3s_binary_x86_64",
    downloaded_file_path = "k3s",
    sha256 = "fb942b7870d9a88e10d063e9f52b99fa538becca761e2578887e04e5ce167e53",
    urls = ["https://github.com/k3s-io/k3s/releases/download/v1.30.4+k3s1/k3s"],
)
