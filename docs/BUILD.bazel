# Generated API reference. `bazel run //docs:update` regenerates docs/*.md;
# the generated `//docs:update_test`-style diff tests fail CI when a
# docstring in //firecracker:defs.bzl changes without regenerating.

load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@stardoc//stardoc:stardoc.bzl", "stardoc")

stardoc(
    name = "defs_docs",
    out = "defs_generated.md",
    input = "//firecracker:defs.bzl",
    deps = ["//firecracker:defs"],
)

write_source_files(
    name = "update",
    files = {"defs.md": ":defs_docs"},
)
